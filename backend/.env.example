# ==========================================
# PathCare Backend Environment Variables
# Documented template — NO fabricated or real credentials
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas M10 / Local replica set)
# Format: mongodb://localhost:27017/pathcare or mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pathcare?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pathcare

# Cache & Queues (Redis ElastiCache / Local Redis)
# Format: redis://localhost:6379 or rediss://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Payments (Razorpay Checkout & Webhooks) - NO Route integration (§2.2)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Signing key for object URLs. Separate from JWT_SECRET on purpose:
# session signing and object signing are different trust domains.
STORAGE_SIGNING_SECRET=your_storage_signing_secret_min_32_chars

# Object Storage (AWS S3 ap-south-1 Mumbai)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=pathcare-reports-private

# SMS & WhatsApp Service Providers
SMS_API_KEY=your_sms_provider_api_key
SMS_SENDER_ID=PATHCR
WHATSAPP_API_KEY=your_whatsapp_meta_api_key
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Business Configuration Defaults (Config-driven, no magic numbers §3.4)
CANCELLATION_FEE_INR=20
RIDER_SEARCH_RADIUS_KM=5
LAB_VISIT_AUTO_CANCEL_HOURS=8
OTP_TTL_SECONDS=60

# Rate Limits (CONTEXT §8) - environment-overridable per §3.4
RATE_LIMIT_UNAUTH_MAX=100
RATE_LIMIT_UNAUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=500
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_OTP_PHONE_MAX=5
RATE_LIMIT_OTP_PHONE_WINDOW_SECONDS=3600
RATE_LIMIT_OTP_IP_MAX=20
RATE_LIMIT_OTP_IP_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# Number of proxy hops to trust for X-Forwarded-For (1 = single ALB in front)
TRUST_PROXY_HOPS=1

# Feature Flags (§3.5). A NEW user-facing feature defaults to false.
# FF_DYNAMIC_DISPATCH is a KILL SWITCH for already-shipped automatic rider
# dispatch: it is ON unless set to false. Setting it false degrades to manual
# dispatch (bookings still created, riders claim them from the job board).
FF_DYNAMIC_DISPATCH=true
FF_RAZORPAY_AUTO_REFUND=false
FF_PRESCRIPTION_OCR=false
# Push notifications to the rider app. New feature, so defaults to false (§3.5).
FF_PUSH_NOTIFICATIONS=false

# ── Subscriptions (recurring test packages) ────────────────────────────────
# Ships behind a flag defaulting to false (CONTEXT §3.5).
FF_SUBSCRIPTIONS=false
# Cadences offered, in days.
SUBSCRIPTION_ALLOWED_FREQUENCY_DAYS=30,60,90,180,365
SUBSCRIPTION_DEFAULT_FREQUENCY_DAYS=90
# Ceiling on cycles a single UPI AutoPay mandate covers (Razorpay total_count).
SUBSCRIPTION_MAX_CYCLES=24
# RBI requires notice at least this many hours before every recurring debit.
# This is a compliance floor — do not lower it.
SUBSCRIPTION_PREDEBIT_NOTICE_HOURS=24
# How far ahead the sweep looks. Wider than the floor so a late or skipped
# sweep still notifies rather than letting a debit go out with no notice.
SUBSCRIPTION_PREDEBIT_WINDOW_HOURS=48
SUBSCRIPTION_SWEEP_INTERVAL_MS=3600000
