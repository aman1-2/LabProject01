dist
build
# Any env file, however it is suffixed. The narrower list here previously
# covered .env, .env.local and .env.*.local only — so a sidecar like
# `.env.bak-qa` or `.env.prod` was NOT ignored and a `git add .` would have
# committed live AWS and payment-gateway secrets. Ignore them all, then
# re-admit the checked-in templates.
.env
.env.*
!.env.example
!.env.*.example
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
coverage
.nyc_output
.expo/
.expo-shared/
*.tsbuildinfo
test-results/
playwright-report/
blob-report/

# Local scratch/analysis scripts
scratch_*
