# PathCare Rider (Expo) — client configuration.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time and are
# readable by anyone with the APK. Never put a secret here.

# Base URL of the PathCare API. No trailing slash.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Google Maps SDK for Android key, used by the Map tab.
# Restrict it to the app's package name and SHA-1 in Google Cloud Console.
# Leave unset in development: the Map tab then shows an explicit
# "map key not configured" state instead of an empty grey grid.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# EAS project id. Required for push notifications in a standalone build;
# unset in Expo Go, where a project-scoped token is not issued.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Locale — all five REQUIRED; the build refuses without them.
EXPO_PUBLIC_CITY=Moradabad
EXPO_PUBLIC_STATE=Uttar Pradesh
EXPO_PUBLIC_SAMPLE_AREA=Civil Lines
EXPO_PUBLIC_DEFAULT_LAT=28.8386
EXPO_PUBLIC_DEFAULT_LNG=78.7733
