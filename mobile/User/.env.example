# PathCare (patient app) — client configuration.
# EXPO_PUBLIC_* values are inlined into the JS bundle. Never put a secret here.

# Base URL of the PathCare API. No trailing slash.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Google Maps SDK for Android key, used by the live tracking map.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# EAS project id. Required for push notifications in a standalone build.
EXPO_PUBLIC_EAS_PROJECT_ID=
