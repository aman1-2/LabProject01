# ==========================================
# PathCare Frontend Environment Variables
# Documented template — NO fabricated credentials
# ==========================================

# Backend API URL
VITE_API_URL=http://localhost:5000

# WebSocket URL
VITE_WS_URL=http://localhost:5000

# Razorpay Checkout Public Key (Test mode key)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# WhatsApp support number, digits only including country code (e.g. 911234567890).
# Leave blank and the WhatsApp FAB is hidden rather than linking to a wrong number.
VITE_WHATSAPP_NUMBER=

# Target city configuration (Single city launch per §2.5)
VITE_CITY=Dehradun

# Feature Flags (§3.5) - default false; unset means off
# VITE_WHATSAPP_NUMBER must also be set for the FAB to render (digits only).
VITE_FF_WHATSAPP_FAB=false
VITE_FF_PICK_AND_DROP_BANNER=false
