{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @pathcare/frontend build",
  "installCommand": "pnpm install --frozen-lockfile --filter @pathcare/frontend...",
  "outputDirectory": "dist",
  "framework": "vite",
  "github": {
    "silent": true
  },
  "rewrites": [
    {
      "source": "/((?!assets/|img/|fonts/|favicon|robots\\.txt|manifest\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=(self)"
        }
      ]
    }
  ]
}
